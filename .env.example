# Porta local (o Render define automaticamente em producao)
PORT=4000

# String de conexao do MongoDB Atlas (troque <senha> pela senha real do usuario do banco)
MONGODB_URI=mongodb+srv://bibliotecario:SUASENHA@cluster0.xxxxx.mongodb.net/biblioteca_admpb?retryWrites=true&w=majority

# Chave secreta usada para assinar o token de login.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_gigante
JWT_EXPIRES_IN=12h

# Usuario e senha do administrador (usados por: npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha

# Enderecos do front que podem chamar esta API (separados por virgula, sem barra no final)
CORS_ORIGIN=http://localhost:5173

# OPCIONAL - SerpAPI (busca do Google). So e usada quando as APIs gratuitas de
# ISBN nao acham a capa/o titulo. Sem a chave, essa etapa e simplesmente pulada.
SERP_API_KEY=

# Cloudinary: guarda as fotos de capa tiradas/enviadas pelo app.
# Sem estas tres, o envio de foto fica indisponivel (o resto funciona).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

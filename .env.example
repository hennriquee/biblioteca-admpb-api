# Porta local (o Render define automaticamente em producao)
PORT=4000

# String de conexao do MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/biblioteca_admpb?retryWrites=true&w=majority

# Chave secreta usada para assinar o token de login
JWT_SECRET=troque_por_uma_chave_grande_e_aleatoria
JWT_EXPIRES_IN=12h

# Enderecos do front que podem chamar esta API (separados por virgula)
CORS_ORIGIN=http://localhost:5173

# SerpAPI (busca do Google por ISBN) - opcional
SERP_API_KEY=

# Cloudinary (fotos de capa). Os nomes NAO podem ter espaco.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
